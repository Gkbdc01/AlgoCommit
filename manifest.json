{
  "manifest_version": 3,
  "name": "AlgoCommit",
  "version": "1.0",
  "description": "Automatically capture accepted LeetCode solutions and push them to GitHub.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}