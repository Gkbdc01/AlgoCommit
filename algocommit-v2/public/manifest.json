{
  "manifest_version": 3,
  "name": "AlgoCommit V2",
  "version": "2.0",
  "description": "Automatically capture accepted LeetCode solutions and push them to GitHub.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/content.js"]
    }
  ],
  "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
  }
}